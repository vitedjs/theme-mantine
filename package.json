{
  "name": "@vited/theme-mantine",
  "version": "0.1.0",
  "description": "Mantine React theme for Vited documentation sites",
  "homepage": "https://github.com/vitedjs/theme-mantine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitedjs/theme-mantine.git"
  },
  "license": "MIT",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.14.0",
      "onFail": "error"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "wouter": "^3.13.0"
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.4",
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.7.4",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.0",
    "@vited/cli": "link:../cli",
    "@vited/core": "link:../core",
    "react": "^19.3.1",
    "tsdown": "^0.23.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
